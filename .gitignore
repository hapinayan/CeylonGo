# ==========================================
# CeylonGo — Root .gitignore
# Multi-stack configuration for Angular, Flutter, Python, Database & AI
# ==========================================

# ------------------------------------------
# Operating System
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------
# IDEs & Editors
# ------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
.history/
*.code-workspace

# VS Code: Ignore machine-specific state while preserving shared workspace configuration
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------
# Environment & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
*.jks
credentials.json
client_secret*.json

# ------------------------------------------
# Angular / Node.js / Frontend
# ------------------------------------------
node_modules/
.angular/
.angular/cache/
dist/
coverage/
.npm
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------
# Flutter / Dart / Mobile App
# ------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
.widget_preview/

# Flutter Ephemeral & Machine-specific build files
**/ios/Flutter/.last_build_id
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Pods/
**/ios/.symlinks/
**/ios/profile
**/ios/debug
**/android/app/debug
**/android/app/profile
**/android/app/release
**/android/local.properties
**/android/key.properties
**/android/.gradle/
**/android/captures/
app.*.symbols
app.*.map.json

# ------------------------------------------
# Python & AI Services
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ------------------------------------------
# General Logs & Temporary Files
# ------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*~
